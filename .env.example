# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/slotly?sslmode=verify-full"
# Direct (unpooled) connection — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/slotly?sslmode=verify-full"
# Separate database for integration tests (e.g. a Neon branch named "test").
# WARNING: integration tests TRUNCATE every table in this database.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/slotly?sslmode=verify-full"

# ─── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ─── Business rules ────────────────────────────────────────────────────────────
BUSINESS_TIMEZONE="Europe/London"
CANCELLATION_CUTOFF_HOURS="24"

# ─── AI: embeddings ────────────────────────────────────────────────────────────
# local  = free, runs Xenova/bge-small-en-v1.5 in-process (no API key)
# gemini = Google gemini-embedding-001 (free tier key required)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="Xenova/bge-small-en-v1.5"

# ─── AI: LLM (free tiers) ──────────────────────────────────────────────────────
# none   = retrieval-only extractive answers (no key needed)
# groq   = https://console.groq.com (free tier)
# gemini = https://aistudio.google.com (free tier)
LLM_PROVIDER="none"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
LLM_TIMEOUT_MS="20000"

# ─── RAG tuning ────────────────────────────────────────────────────────────────
RAG_TOP_K="5"
RAG_CHUNK_SIZE="800"
RAG_CHUNK_OVERLAP="120"
# Candidate pre-filter on cosine distance (0 = identical); the reranker decides relevance.
RAG_MAX_DISTANCE="0.6"
RAG_CANDIDATES="12"
# Cross-encoder reranker (local, free). Scores are logits; tune thresholds with `pnpm eval:rag`.
RAG_RERANK="true"
RAG_RERANK_MODEL="Xenova/ms-marco-MiniLM-L-6-v2"
RAG_MIN_RERANK_SCORE="-10.6"
RAG_CONFIDENT_RERANK_SCORE="0"

# ─── Demo accounts ─────────────────────────────────────────────────────────────
# The app has no sign-in page: a "Continue as…" switcher starts a real session for one
# of the seeded demo users. Set to "false" in any deployment that holds real data.
DEMO_ACCOUNTS_ENABLED="true"
SEED_ADMIN_EMAIL="admin@slotly.dev"
SEED_CUSTOMER_EMAIL="maya@slotly.dev"
SEED_SECOND_CUSTOMER_EMAIL="sam@slotly.dev"
